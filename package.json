{
  "name": "asports-billing",
  "version": "1.0.9",
  "description": "ASPORTS ZONE Billing System",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "rebuild": "npx @electron/rebuild",
    "postinstall": "npx @electron/rebuild",
    "dist": "electron-builder --win",
    "publish": "publish.bat"
  },
  "build": {
    "appId": "com.asports.billing",
    "productName": "ASPORTS ZONE Billing",
    "copyright": "Copyright © 2026 ASPORTS ZONE",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "chakrashen",
      "repo": "asports-billing",
      "releaseType": "release"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    },
    "files": [
      "**/*",
      "!dist/*",
      "!node_modules/@electron/rebuild/*"
    ],
    "extraFiles": [
      {
        "from": "node_modules/electron/dist/ffmpeg.dll",
        "to": "ffmpeg.dll"
      },
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "asar": true
  },
  "keywords": [],
  "author": "ASPORTS ZONE",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.3",
    "nodemailer": "^8.0.7",
    "pdfkit": "^0.18.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^24.13.3"
  }
}
